    <add key="Ubicaciones:RegistrarMovimientos" value="false" />
    <!-- NestoAPI#634 (corte 1): al recibir una reposición con diferencias, ajustar el stock del ORIGEN (falta: entrada; sobra:
         salida) por prdExtrProducto en el diario _ErrRepo, y mover stock al resolver la diferencia. Nace APAGADO: con false
         solo queda constancia en DiferenciasReposiciones y se avisa (Almacén + quien la preparó). Encenderlo (true) despues
         de lanzar como sa Scripts/Issue634_DiferenciasReposiciones.sql. Se enciende AQUI, en el repo: a mano en el servidor lo
         apagaria la siguiente publicacion. -->
    <!-- 15/10/26 (Carlos): ENCENDIDO desde el primer deploy de #634 (script Issue634 lanzado antes de publicar). -->
    <add key="Reposiciones:AjustarStockDiferencias" value="true" />
    <!-- Sugerencia 753 (Paloma, Alcobendas; Carlos 23/10/26): al terminar una reposicion desde una tienda SIN control de
         ubicaciones (Reina, Alcobendas: Almacenes.ControlUbicaciones = 0), lo que Ariadna manda como "No esta" (cuerpo
         { NoEsta } de POST api/Reposiciones/EnPreparacion/Terminar) deja el stock de ese producto a 0 en la tienda
         (prdExtrProducto, diario _ErrRepo, despues de confirmar la reposicion). Con ubicaciones (Algete) no cambia nada.
         Apagado / Activo (sin la clave, Apagado). No necesita script. Se enciende AQUI, en el repo: a mano en el servidor
         lo apagaria la siguiente publicacion. -->
    <add key="Reposiciones:NoEstaStockACero" value="Activo" />
    <!-- NestoAPI#646 (corte API-2): varias PDA en la misma salida (picking o reposicion). Las faltas se suman entre PDA: si
         una da por falta lo que otra ya ha cogido, se quitaba del pedido aunque fuera en la caja. Encendido (true), al
         terminar se quita de cada producto solo lo que de verdad queda sin leer (min(faltas, esperado - leido)) y se explica
         en Cambios. Nace APAGADO: con false, como siempre, y el ensayo (?ensayo=true) dice en Cambios lo que se quitaria
         encendido. No necesita script. Se enciende AQUI, en el repo: a mano en el servidor lo apagaria la siguiente
         publicacion. -->
    <add key="Salidas.RecortarFaltas" value="false" />
    <!-- NestoAPI#693: pedidos cuya fecha de entrega a la agencia prometida se retrasa o se queda sin fecha. Apagado (nace
         asi): no se recalcula nada. Sombra: se recalcula por eventos y de noche y se registra en PedidosPromesaRiesgo, sin
         avisar a nadie (el correo resumen de las 9:00 y las 15:00 va solo a Informatica). Activo: campana de Nesto al vendedor,
         su jefe de equipo y Direccion, y correo resumen a cada uno. Requiere Scripts/Issue693_PedidosPromesaRiesgo.sql (sin
         la tabla no hace nada). Se cambia AQUI, en el repo: a mano en el servidor lo cambiaria la siguiente publicacion.
         Direccion (campana y correo): Pedidos:AvisoPromesaRiesgo:UsuariosDireccion (por defecto "Carlos,Manuel").
         27/10/26 (Carlos, NestoAPI#708): ACTIVO tras la sombra del 22-27/10: 31 detectados, 12 resueltos solos. -->
    <add key="Pedidos:AvisoPromesaRiesgo" value="Activo" />
    <!-- NestoAPI#714 (corte 1, epica #689): clientes que se estan yendo (abandono). Apagado: los jobs riesgo-abandono-resolver
         (L-S 05:10) y riesgo-abandono-diario (L-S 05:20) no hacen nada. Sombra: cada noche se evalua la regla baseline
         (dias sin comprar > 1,5 x cadencia) sobre la cartera de llamadas de cada vendedor y se registra en ClientesRiesgoAbandono
         (alertas y, los lunes, la instantanea de todos los compradores regulares con sus features), y al vencer el horizonte se
         etiqueta (Compro/Abandono/Baja/Desconocido). NADIE ve nada: solo el informe GET api/Clientes/RiesgoAbandono/Informe
         (Direccion e Informatica). Activo (corte 4): origen ABANDONO en las llamadas sugeridas y aviso semanal; en el corte 1 se
         comporta como Sombra. Requiere Scripts/Issue714_ClientesRiesgoAbandono.sql (sin la tabla no hace nada). Se cambia AQUI,
         en el repo: a mano en el servidor lo cambiaria la siguiente publicacion.
         27/10/26 (Carlos): nace en SOMBRA para empezar a acumular datos para el modelo de ML.NET del corte 2. -->
    <add key="Abandono:Modo" value="Sombra" />
    <add key="CorreosPostCompra:ModoTest" value="false" />
    <add key="CorreosPostCompra:EmailsTest" value="manuelrodriguez@nuevavision.es,laura@nuevavision.es,carlosadrian@nuevavision.es" />
    <add key="CorreosPostCompra:Remitente" value="nuevavision@nuevavision.es" />
    <!-- NestoAPI#707: grupo control del correo post-compra de los sabados. Porcentaje (0-100) de clientes que reciben el
         correo con lo que han comprado pero SIN los recomendados; los que habrian visto se guardan igual en
         CorreosPostCompraRecomendaciones con GrupoControl = 1 para medir el uplift (GET api/CorreosPostCompra/Conversion).
         El reparto es estable por cliente (hash de empresa y cliente). 0 = apagado (nace asi: no cambia nada hasta que Carlos
         lo decida; algo como 10 bastaria). Se cambia AQUI, en el repo: a mano en el servidor lo cambiaria la siguiente publicacion. -->
    <!-- 27/10/26 (Carlos): 10 % de grupo control para medir si los recomendados venden (NestoAPI#707). -->
    <add key="CorreosPostCompra:PorcentajeGrupoControl" value="10" />
    <!-- NestoAPI#225: rotación automática de credenciales LWA de Amazon SP-API.
         Las credenciales AWS IAM (AmazonSpApiAccessKey / AmazonSpApiSecretKey) van en
         secretos.config (NO commitear). Aquí solo lo no sensible. -->
    <add key="AmazonSpApi:SqsQueueUrl" value="https://sqs.eu-west-1.amazonaws.com/190854240256/sp-api-credential-rotation" />
    <add key="AmazonSpApi:Region" value="eu-west-1" />
    <add key="AmazonSpApi:EuEndpoint" value="https://sellingpartnerapi-eu.amazon.com" />
    <add key="AmazonSpApi:LwaTokenEndpoint" value="https://api.amazon.com/auth/o2/token" />
    <add key="AmazonSpApi:RotacionDiasAntes" value="15" />
  </appSettings>

  <!-- Configuración de Elmah para logging de errores -->
  <elmah>
    <security allowRemoteAccess="true" />
    <errorLog type="Elmah.SqlErrorLog, Elmah" connectionStringName="NestoConnection" applicationName="NestoAPI" />
    <!-- NestoAPI#183: las cancelaciones de cliente (móvil pierde red, app en background,
         patrones takeUntil/switchMap de RxJS) son inevitables en HTTP y ensucian ELMAH
         con ruido que no aporta nada. Filtramos OperationCanceledException (y por
         herencia TaskCanceledException) para que los errores reales queden visibles.

         Sintaxis: <is-type-compatible> usa Elmah.Assertions.TypeAssertion con
         byCompatibility=true (equivale a `is OperationCanceledException`, así que
         cubre también TaskCanceledException por herencia).
         La versión original con <equal binding="BaseException.GetType().FullName" ...>
         dependía de WebDataBindingExpression (DataBinder.Eval), que no soporta
         llamadas a método y silenciosamente abortaba la cadena de logging,
         dejando ELMAH sin registrar errores reales. -->
    <!-- NestoAPI#336: los escaneos de bots eran el 38% del log. Hasta el 19\08 esto era una
         LISTA NEGRA de patrones de ruta que hubo que ampliar en SEIS barridos (24/07, 11\08,
         17\08, 19\08...) porque cada semana aparecian rutas nuevas: el filtro siempre iba por
         detras de los escaneres.

         24\08 - se INVIERTE a lista blanca. El dato que lo justifica: en 30 dias TODOS los
         System.Web.HttpException del log eran HTTP 404 (328) o 403 (13), ni uno solo de otro
         codigo. Y un HttpException 404 solo puede significar una cosa: la peticion no caso con
         NINGUNA ruta nuestra (Web API devuelve sus 404 como respuesta, no como excepcion, asi
         que nunca llega aqui). Por eso ahora se filtra por CODIGO HTTP y se EXCEPTUAN las rutas
         que si son nuestras, en vez de enumerar las de los bots: los escaneos futuros quedan
         cubiertos sin tocar nada, y esta lista solo cambia si creamos una ruta nueva.

         Rutas NUESTRAS que NO se filtran (su 404 si se registra, que es justo lo que queremos
         ver si un cliente llama a algo que hemos eliminado en un refactor):
           /api/...                      toda la API
           /oauth/...                    endpoint de token de NestoApp (Startup.cs)
           /pago/...                     PagoRedirectController (#121, IgnoreRoute del MVC)
           /pedido/...                   deep link de pedido (DeepLinkController, #107)
           /home/... y /                 HomeController (Index, ResetPassword)
           /logs-nestoapi                dashboard de ELMAH (elmah.mvc.route)
           /hangfire                     dashboard de Hangfire (Startup.cs)
           /.well-known/assetlinks.json  deep linking (#107)
         OJO: el resto de /.well-known/ (discovery de OAuth/OpenID) SI se filtra, solo lo piden
         bots. Y '/api' PELADO tambien se filtra: es una sonda, ningun cliente lo llama.
         CUIDADO: si algun dia se anade un controlador MVC nuevo (o una ruta fuera de /api), hay
         que anadirlo a esta lista o sus 404 se ocultarian en silencio.

         IMPORTANTE: se filtra sobre HttpStatusCode y BaseException.Message, y NUNCA sobre
         Context.Request.Path, porque Context es null en errores senalados fuera de una peticion
         HTTP (jobs de Hangfire) y un binding que lanza ABORTA EN SILENCIO toda la cadena de
         logging de ELMAH (leccion de #183). El mensaje nunca es null y HttpStatusCode es una
         propiedad real de Elmah.Assertions.AssertionHelperContext (lo verifica el test del
         filtro por reflexion, precisamente para que no vuelva a pasar lo de #183).

         El bloqueo REAL de los escaneos sigue estando en <requestFiltering> mas abajo; esto es
         solo para que lo que se cuele no ensucie el log. -->
    <errorFilter>
      <test>
        <or>
          <is-type-compatible binding="BaseException" type="System.OperationCanceledException" />
          <and>
            <!-- Nombre de ensamblado COMPLETO obligatorio: HttpException no esta en mscorlib
                 y Type.GetType sin ensamblado no lo resuelve (lo caza el test del filtro). -->
            <is-type-compatible binding="BaseException" type="System.Web.HttpException, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
            <or>
              <!-- 404: la ruta no casa con ninguna registrada. Es el escaneo de bot. -->
              <equal binding="HttpStatusCode" value="404" type="Int32" />
              <!-- 403 de infraestructura (trace.axd y compania), que ASP.NET rechaza antes de
                   llegar a nuestro codigo. La API nunca lanza HttpException: los 401/403 de
                   [Authorize] son respuestas, no excepciones, y no pasan por aqui. -->
              <equal binding="HttpStatusCode" value="403" type="Int32" />
            </or>
            <!-- Lista blanca: si la ruta es nuestra, NO se filtra. (?i:...) para que /Home y
                 /home valgan igual (el enrutado de MVC no distingue mayusculas). -->
            <not>
              <regex binding="BaseException.Message" pattern="ruta de acceso &apos;/(?i:(api|oauth|pago|pedido)/|(home|logs-nestoapi|hangfire)(/|&apos;)|\.well-known/assetlinks|&apos;)" />
            </not>
          </and>
          <and>
            <!-- 22/09/26: sondas con caracteres prohibidos en la ruta ("/:27018" desde 35.241.239.86),
                 que ASP.NET rechaza con 400 antes de llegar a nuestro codigo. Se filtra SOLO ese
                 mensaje, no todos los 400, para no tapar errores de verdad. -->
            <is-type-compatible binding="BaseException" type="System.Web.HttpException, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
            <equal binding="HttpStatusCode" value="400" type="Int32" />
            <regex binding="BaseException.Message" pattern="Request\.Path" />
          </and>
        </or>
      </test>
    </errorFilter>
  </elmah>

  <!--
    Para obtener una descripción de los cambios de web.config, vea http://go.microsoft.com/fwlink/?LinkId=235367.

    Los siguientes atributos se pueden establecer en la etiqueta <httpRuntime>.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->

  <system.web>
    <customErrors mode="Off" />
    <compilation debug="true" targetFramework="4.8" />
    <!-- NestoAPI#336 (fase 2): no anunciar la versión de ASP.NET a los escáneres -->
    <httpRuntime targetFramework="4.5" enableVersionHeader="false" />
    <httpModules>
      <add name="TelemetryCorrelationHttpModule" type="Microsoft.AspNet.TelemetryCorrelation.TelemetryCorrelationHttpModule, Microsoft.AspNet.TelemetryCorrelation" />
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" />
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" />
      <add name="ErrorMail" type="Elmah.ErrorMailModule, Elmah" />
      <add name="ErrorFilter" type="Elmah.ErrorFilterModule, Elmah" />
    </httpModules>
  </system.web>
