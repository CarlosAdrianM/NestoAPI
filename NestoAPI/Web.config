  -->
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  <sectionGroup name="elmah">
      <section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah" />
      <section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah" />
      <section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah" />
      <section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah" />
    </sectionGroup></configSections>
  <appSettings file=".\secretos.config">
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- NestoAPI#455: a "true", las busquedas de clientes salen del indice Lucene -->
    <!-- NestoAPI#459: a "true", los GET de PlazosPago y FormasPago EXIGEN credencial (JWT o
         API key). Nace apagado a proposito: Nesto se distribuye por ClickOnce y cada puesto
         actualiza al reiniciar, no al publicar; exigirla el mismo dia dejaria sin plazos de
         pago -y en silencio- a quien no hubiera reiniciado. Mientras esta apagado se deja
         pasar y se apunta en ELMAH quien llama sin credencial ([Credenciales #459]). Ponerlo
         a true cuando ese aviso lleve unos dias sin aparecer. -->
    <add key="Seguridad:ExigirCredencialPlazosYFormasPago" value="false" />
    <!-- NestoAPI#455: la busqueda de clientes sale del indice Lucene en vez de los LIKE
         de siempre. ENCENDIDO A PROPOSITO desde el 09/09/26: se encendio a mano en el
         servidor el 04/09 y cada publicacion lo devolvia a false, asi que "bellsir" dejo
         de encontrar "Bellsur". Si el indice falla o esta a medio construir, el codigo se
         cae solo a la busqueda antigua y lo apunta en ELMAH, asi que apagarlo solo hace
         falta si el indice diera resultados peores. -->
    <add key="Buscador:ClientesPorIndice" value="true" />
    <!-- NestoAPI#593: a "true", la primera factura de la campana de cheque regalo genera el cheque
         (ServicioFacturas.CrearFactura y el job diario cheques-regalo-reconciliacion). Nace apagado:
         se enciende AQUI (en el repo, no a mano en el servidor: la publicacion lo devolveria a false).
         09/10/26: encendido ya. Solo genera con facturas dentro de GeneraDesde/GeneraHasta de una campana
         con Activa = 1 (octubre: del 12 al 29/10), asi que no hace falta publicar el dia del lanzamiento. -->
    <add key="ChequesRegalo:Generar" value="true" />
    <!-- NestoAPI#593: copia oculta de los correos del cheque al cliente. Vacio = ninguna (Carlos 13/10/26: ya ha visto que
         salen bien; el registro de cada envio queda en ChequesRegalo.FechaAvisoCorreo/CorreoAviso). Sin la clave, Informatica. -->
    <add key="ChequesRegalo:CopiaOculta" value="" />
    <!-- NestoAPI#660 / #593: la URL publica de la API, la de los enlaces que salen en los correos (la miniatura del cheque
         regalo en el correo de confirmacion del pedido de la app). Sin la clave, https://api.nuevavision.es. -->
    <add key="UrlPublicaApi" value="https://api.nuevavision.es" />
    <!-- TNV#68: a "true" (o ausente) el pedido de la app se COBRA ANTES de crearse. Nace
         encendido porque es el orden correcto: cancelar en Redsys ya no deja pedidos fantasma
         (pedido 925607, 07/09/26). Existe para poder volver al orden antiguo -crear y luego
         cobrar- desde aqui, sin esperar a que Google apruebe una version de la app, que es lo
         unico que no se podria hacer deprisa si algo fallara en el cobro. -->
    <add key="Pagos:CobrarCarritoAntesDelPedido" value="true" />
    <!-- NestoAPI#612: a "true", al pagarse una inscripcion a un evento (enlace, senal de #591 marcada o pago a mano)
         se crea el pedido del curso, se factura exento en CV, se liquida la senal contra la factura y la inscripcion
         pasa a Facturada (y, con el corte 3, se emite el cupon). Nace APAGADO: antes de encenderlo hay que lanzar
         Scripts/Issue612_FacturacionCursosEventos.sql y dar fechas de Ventas y Contabilidad en FechasPermitidas al
         usuario automatico (Eventos:UsuarioAutomatico, por defecto SenalesEventos). Se enciende AQUI, en el repo. -->
    <add key="Eventos:FacturarCursoAlCobrar" value="true" />
    <!-- NestoAPI#690: a "true", dos dias antes de cada evento, a las 10:00 (job recordatorio-eventos, nunca fuera de
         9:00-21:00), push a la app del cliente y correo con Confirmo asistencia / No podre ir. Nace APAGADO; antes de
         encenderlo, Scripts/Issue690_EventosHorarioModalidadAsistencia.sql. Se enciende AQUI, en el repo. -->
    <add key="Eventos:RecordatorioAsistencia" value="true" />
    <!-- Decision de Carlos (22/10/26): a "true", la reserva sin pagar vence Eventos.DiasPagoAntesEvento dias antes del evento
         (NULL = 7); dos dias antes de vencer, push y correo «su plaza sin pagar se libera el dia X» (job recordatorio-eventos,
         10:00) y, pasado el plazo y avisada, la plaza se libera (Caducada). Nace APAGADO; antes, el script de #690. -->
    <add key="Eventos:LiberarReservasSinPagar" value="true" />
    <!-- NestoAPI#615: a "true", al contabilizar un cobro a cuenta de un cliente (api/PreContabilidades), al puntearlo con el
         banco (api/Bancos/PuntearApuntes) y en el barrido de las 7:50 (job senales-eventos) se buscan los eventos de los que
         puede ser la senal (importe exacto + inscripcion reservada o concepto que lo menciona) y se PROPONEN. No marca nada:
         confirma Administracion. Nace APAGADO: antes hay que lanzar Scripts/Issue615_PropuestasSenalesEventos.sql. -->
    <add key="Eventos:ProponerSenales" value="true" />
    <!-- NestoAPI#613: el producto ficticio de la linea de descuento del cupon (lo crea Scripts/Issue613_Cupones.sql). -->
    <add key="Cupones:Producto" value="CUPONEVENTO" />
    <!-- NestoAPI#613: a "true", al emitirse un cupon se manda al cliente un correo con el codigo y las normas. Nace APAGADO
         hasta que Carlos vea el texto (AvisadorCupones.Correo) y este el PDF de normas en Novedades (#616): su enlace va en
         Cupones:UrlNormas. Sin correo, el cliente lo ve en la app y el vendedor recibe la push igual. -->
    <add key="Cupones:CorreoCliente" value="true" />
    <add key="Cupones:UrlNormas" value="" />
    <!-- NestoAPI#614: a "true", NestoAPI lleva los cupones a la tienda PrestaShop (cart_rules por webservice, con la clave
         PrestashopWebserviceKeyNV de secretos.config), los desactiva alli antes de confirmar un pedido que los usa y acepta
         POST api/Cupones/{codigo}/Usar (pedido de la tienda importado por Nesto). Job cupones-prestashop cada 15 minutos.
         Nace APAGADO: antes, Scripts/Issue614_CuponesPrestashop.sql y dar a la clave del webservice GET/POST/PUT en
         cart_rules y GET en customers. Cupones:HorasAvisoEspejo: horas sin espejo antes del correo a Informatica. -->
    <add key="Cupones:EspejoPrestashop" value="false" />
    <add key="Cupones:HorasAvisoEspejo" value="4" />
    <add key="Cupones:PrestashopIdIdioma" value="1" />
    <add key="Cupones:PrestashopIdMoneda" value="1" />
    <!-- NestoAPI#614: a "true", Nesto puede pasar la compra de un curso en PrestaShop como pago de la inscripcion
         (POST api/Eventos/CursoTienda) en vez de facturarla como pedido normal. Nace APAGADO. -->
    <add key="Eventos:CursosDesdePrestashop" value="false" />
    <!-- NestoAPI#691: a "true", en el pedido de cursos de la plantilla (uno para todos los cursos, serie CV, prepago) cada
         linea se factura en cuanto entra el pago de su inscripcion (enlace del pedido, senal por transferencia o "Marcar
         pagada"), sin esperar al evento; pagadas juntas, una sola factura. Solo manda este: NO hace falta
         Eventos:FacturarCursoAlCobrar (que sigue mandando en las inscripciones sin pedido de #612). Apagado, la inscripcion se
         queda Pagada y la linea pendiente. Nace APAGADO: antes, Scripts/Issue691_CursosPlantilla.sql y
         Scripts/Issue691_CursosUnPedido.sql (sin ellos, no se pueden crear pedidos de cursos). -->
    <add key="Eventos:FacturarCursosPlantilla" value="true" />
    <!-- Configuración Verifacti (proveedor Verifactu).
         Habilitado=true desde el 20/07/26: es la fase en SOMBRA (#41). La clave empieza por
         "vf_test_", que ServicioVerifacti reconoce como sandbox, así que las facturas se registran
         contra el entorno de pruebas de la AEAT (prewww2.aeat.es) y NO tienen efecto fiscal.
         El QR lleva además su propia guarda: GestorFacturas.EsQrDeProduccion rechaza cualquier URL
         con "prewww", de modo que un QR de sandbox no se imprime jamás.
         Estaba a false en el repo y a true en el servidor (se activó editando el Web.config en
         vivo); se sube aquí para que el despliegue no apague la sombra sin querer.
         Para pasar a producción hay que cambiar la ApiKey por una "vf_live_", no este flag. -->
    <add key="Verifacti:ApiKey" value="vf_test_qESaoRRR7Oq2MJgyTeVcc07WoeDcogPb4vpVA9lYYFo=" />
    <add key="Verifacti:BaseUrl" value="https://api.verifacti.com/" />
    <add key="Verifacti:Habilitado" value="true" />
    <!-- NestoAPI#326: QR local. Sin AMBAS claves rellenadas NO se genera QR en local (fallback al
         comportamiento actual). El numserie que registra Verifacti es {PrefijoNumSerie}{Serie}{Número}
         (Verifacti antepone un prefijo por emisor, hoy "8f44_" en pruebas) y el NIF es el del emisor
         registrado en Verifacti (en pruebas B75777847, en producción el real). ⚠️ Ambos valores
         CAMBIAN en producción: confirmar con Verifacti (idealmente su maestro de emisores/series)
         antes de rellenarlos, porque un QR con un numserie que la AEAT no tiene registrado sería
         peor que no tener QR. -->
    <add key="Verifacti:NifEmisor" value="" />
    <add key="Verifacti:PrefijoNumSerie" value="" />
    <!-- NestoAPI#522: justificante provisional. Fecha (yyyy-MM-dd) a partir de la cual una factura de
         una serie que tramita Verifactu y que aún NO está registrada (caída de Verifacti o de la
         conexión) se imprime y se envía como «DOCUMENTO PROVISIONAL: no es una factura» en vez de
         como factura. VACÍO = APAGADO (fase en sombra: todo se imprime como siempre). Encender el
         01/12/2026 con la fecha de entrada en producción, a la vez que la api-key vf_live_ (#42):
         las facturas anteriores a esa fecha no tenían obligación y siguen saliendo como facturas. -->
    <add key="Verifactu:JustificanteProvisionalDesde" value="" />
    <!-- NestoAPI#522: recordatorio diario (laborables, 8:30) en la campana de Nesto con las facturas
         pendientes de Verifactu o incorrectas en la AEAT. UsuariosAvisoPendientes: usuarios sin dominio,
         separados por comas; vacío = los del grupo Administración del dominio. -->
    <add key="Verifactu:AvisoDiarioPendientes" value="true" />
    <add key="Verifactu:UsuariosAvisoPendientes" value="" />
    <!-- Innovatrans: WebService DataTrans DTX. Lo NO sensible va aquí; la password (de la que se
         calcula clave = MD5(password)) va en secretos.config como "InnovatransPassword". -->
    <add key="Innovatrans:Url" value="http://h001.iatsl.es:8081/dtxSW/services/" />
    <!-- GLS/ASM: uid (GUID de cliente) para el tracking GetExpCli. Hoy el de BusinessParcel (servicio 96),
         que es como salen casi todos los envíos. Solo lectura de seguimiento, no es secreto. -->
    <add key="GLS:UidSeguimiento" value="6fb665f2-15a2-4478-9804-c1556fc1f272" />
    <!-- NestoAPI#552 (fase 2): POST api/EnviosAgencias/{id}/Tramitar graba en GLS (GrabaServicios) los envios de GLS, con la
         peticion de PeticionGls y la fecha del dia de tramitacion, y deja la llamada en AgenciasLlamadasWeb como Nesto. No
         cierra el envio (eso sigue siendo ConfirmarTramitacion) ni imprime la etiqueta (sigue en Nesto). Nace APAGADO: con
         false GLS da el 400 de siempre y se tramita desde Nesto (AgenciaASM). Sin credenciales: la cuenta va en el uid de la
         peticion (AgenciasTransporte.Identificador o el de BusinessParcel). Se enciende AQUI, en el repo: a mano en el
         servidor lo apagaria la siguiente publicacion.
         Fase 4 (mismo interruptor, solo la agencia 1): GET api/EnviosAgencias/{id}/EtiquetaZpl da la etiqueta de GLS montada
         en la API sin grabar en GLS; POST {id}/ImprimirEtiqueta y la etiqueta del packing de Ariadna la imprimen en el
         servidor; POST api/EnviosAgencias/TramitarTodos graba en GLS y cierra los envios al acabar el dia. Nesto usa estos
         caminos solo con su parametro de usuario GlsPorApi = API (Scripts/Nesto552_ParametroGlsPorApi.sql).
         Fase 5 (mismo interruptor): tambien la agencia 5 (GLS de la empresa espejo), con su propia cuenta, que esta en la BD
         (AgenciasTransporte.Identificador y PrefijoCodigoBarras de la fila 5, como AgenciaASM): no necesita claves aqui.
         Con -33 (GLS ya lo tenia), si los datos cambiaron desde que se grabo, TramitarTodos lo cierra pero lo avisa. -->
    <add key="Agencias:GlsTramitarPorApi" value="false" />
    <!-- NestoAPI#552 (fase 3): POST api/EnviosAgencias/{id}/Anular anula en GLS (operacion Anula del WS b2b) un envio de
         GLS En curso con codigo de barras, y lo devuelve a etiqueta pendiente, como con CTT. Nace APAGADO: con false GLS da
         el 400 de siempre. La operacion Anula no la ha usado nunca Nesto: antes de encenderlo, comprobar su contrato con
         una llamada de prueba (ver la issue). Se enciende AQUI, en el repo, por lo mismo que el de tramitar. -->
    <add key="Agencias:GlsAnularPorApi" value="false" />
    <!-- El identificador (nº de cliente DataTrans) vive en AgenciaTransporte.Identificador (fila 12),
         como en las demás agencias. La empresa (código DTX) es config de conexión y se queda aquí. -->
    <add key="Innovatrans:Empresa" value="91253" />
    <add key="Innovatrans:Email" value="carlosadrian@nuevavision.es" />
    <!-- Remitente fijo (nuestro almacén de Algete) para los envíos de Innovatrans. -->
    <add key="Innovatrans:Remitente:Nombre" value="NUEVA VISIÓN, S.A." />
    <add key="Innovatrans:Remitente:Telefono" value="916281914" />
    <add key="Innovatrans:Remitente:CodigoPostal" value="28119" />
    <add key="Innovatrans:Remitente:Poblacion" value="ALGETE" />
    <add key="Innovatrans:Remitente:Direccion" value="Río Tiétar, 11, Pol. Ind. El Nogal" />
    <!-- NestoAPI#493: CTT Express, API REST. Lo NO sensible va aquí; las credenciales OAuth2 van en
         secretos.config como "CTTClientId" y "CTTClientSecret". Mientras CTT sea agencia sombra
         (AgenciasTransporte.EsSombra = 1) nada de esto se usa. Aquí va la URL de PRODUCCIÓN; para
         probar contra el sandbox, secretos.config (local) sobreescribe CTT:Url con
         https://api-test.cttexpress.com/integrations/ y lleva las credenciales de test. El código de
         centro (8090300001) es el mismo en test y producción. Freno de arranque: parámetro de usuario
         CTTZonasActivas (p. ej. "Provincial"); vacío = todas las zonas. -->
    <add key="CTT:Url" value="https://api.cttexpress.com/integrations/" />
    <add key="CTT:ClientCenterCode" value="8090300001" />
    <add key="CTT:Remitente:Nombre" value="NUEVA VISION S.A." />
    <add key="CTT:Remitente:Telefono" value="916281914" />
    <add key="CTT:Remitente:CodigoPostal" value="28110" />
    <add key="CTT:Remitente:Poblacion" value="ALGETE" />
    <add key="CTT:Remitente:Direccion" value="C/ RIO TIETAR 11, POL. IND. LOS NOGALES" />
    <add key="CTT:Remitente:Email" value="" />
    <!-- NestoAPI#710 (incidencia 785): qué mandan por SignalR a las demás PDA las lecturas y las correcciones de una salida o de un
         packing. "Ambos" (por defecto, también sin la clave): los eventos con datos (lectura / lecturas / correccion) y, detrás, el
         "haCambiado" de siempre, para las Ariadna anteriores a la 2.19 (solo escuchan ese). "SoloDatos": solo los eventos con datos,
         cuando TODAS las PDA tengan la 2.19 o posterior. "SoloHaCambiado": como antes de #710 (freno de mano). Terminar, cambiar de
         hueco, la foto de un bulto y anular lecturas mandan siempre "haCambiado". Se cambia AQUÍ, en el repo: a mano en el servidor
         lo revierte la siguiente publicación. -->
    <add key="Almacen:AvisosConDatos" value="Ambos" />
  <add key="elmah.mvc.disableHandler" value="false" />
    <add key="elmah.mvc.disableHandleErrorFilter" value="false" />
    <add key="elmah.mvc.requiresAuthentication" value="false" />
    <add key="elmah.mvc.IgnoreDefaultRoute" value="false" />
    <add key="elmah.mvc.allowedRoles" value="*" />
    <add key="elmah.mvc.allowedUsers" value="*" />
    <add key="elmah.mvc.route" value="logs-nestoapi" />
    <add key="elmah.mvc.UserAuthCaseSensitive" value="true" />
    <!-- Issue #74: Correos post-compra semanales -->
    <!-- TNV#66: avisos push al cliente cuando cambia el estado de su pedido. Apagado hasta que
         la app con la pantalla "Mis pedidos" esté EN PRODUCCIÓN en Play Store: los avisos remiten
         a esa pantalla, y los clientes que hoy tienen la app instalada aún no la tienen. Cuando
         esté publicada, poner true (y haber ejecutado antes TNV66_NotificacionesEstadoPedido.sql).
         Sirve además como freno de mano: si algún día hay que cortar los avisos, se apaga aquí. -->
    <add key="AvisosPedidos:Activo" value="false" />
    <!-- NestoAPI#547 (corte c): el incremental de precios medios ESCRIBE Productos.PrecioMedio, LinPedidoCmp.Coste
         y LinPedidoVta.Coste (job diario de las 2:30 y encolado al facturar compras). Nace APAGADO: encenderlo
         (true) solo cuando la sombra de los domingos (parametro PreciosMediosSombra) lleve dos domingos seguidos
         sin diferencias no esperadas. Se enciende AQUI, en el repo: a mano en el servidor lo apagaria la
         siguiente publicacion. Para cortarlo de golpe, false. El SP del domingo sigue de red. -->
    <!-- 15/10/26 (Carlos): ENCENDIDO. Sombra del 04/10 y del 11/10 limpias (0 distintos, 0 errores; los 620 empates esperados). -->
    <add key="PreciosMedios:EscribirIncremental" value="true" />
    <!-- Recordatorios de respuesta en Novedades (Carlos, 16/10/26): el job novedades-recordatorios-respuesta (L-V 9:00)
         recuerda al autor de una sugerencia o incidencia que el asistente le ha preguntado algo (EsperaRespuesta) cada 2
         dias laborables sin respuesta, dos veces, y a la tercera la pasa a Cerrada (el autor la sigue viendo y la reabre
         comentando). Requiere Scripts/NovedadesRecordatoriosRespuesta.sql. false = el job no hace nada (marcar la
         espera y reabrir al comentar siguen funcionando). Ensayo: POST api/Novedades/RecordatoriosRespuesta?ensayo=true. -->
    <add key="Novedades:RecordatoriosRespuesta" value="true" />
    <!-- NestoAPI#674: el job informe-codigos-barras (lunes 8:10) manda a Compras los productos activos sin codigo de barras,
         con un codigo que no es un GTIN valido y con un codigo compartido (Excel adjunto). false = el job no hace nada. Se
         cambia AQUI, en el repo: a mano en el servidor lo cambiaria la siguiente publicacion. -->
    <add key="CodigosBarras:InformeSemanal" value="true" />
    <!-- NestoAPI#643: el job nocturno outlet-cuadre-nocturno (04:00) mantiene las categorias Outlet (PEL/OUT, COS/OUM,
         COS/OUT) a partir del estado 4 de los productos que estan en la tienda y los republica por Nesto_sync. Nace
